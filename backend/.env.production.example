# ── PRODUCCIÓN ──────────────────────────────────────────────────
# Copiar a .env.production y completar valores reales.
# NUNCA subir .env.production al repositorio git.

NODE_ENV=production

# Base de datos (PostgreSQL en servidor de producción)
DB_HOST=YOUR_DB_HOST
DB_PORT=5432
DB_USERNAME=YOUR_DB_USER
DB_PASSWORD=YOUR_STRONG_DB_PASSWORD
DB_NAME=conejo_motors_prod

# JWT — usar una clave larga aleatoria en producción
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRATION=1d

# Usuario administrador inicial (solo se crea si no existe)
ADMIN_EMAIL=admin@conejomotors.cr
ADMIN_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# NOTA: Con NODE_ENV=production, TypeORM NO hace synchronize automático.
# Usar migraciones para cambios en el esquema:
#   npm run typeorm migration:generate -- src/migrations/NombreMigracion
#   npm run typeorm migration:run
